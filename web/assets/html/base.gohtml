{{define "base"}}
<!doctype html>
<html lang='en' data-theme="{{ .Theme }}">
  <head>
    <meta charset='utf-8'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script defer src="/static/vendor/js/htmx_v4-0-0.min.js"></script>
    <script defer src="/static/js/scripts.js"></script>
    <script defer src="/static/js/markdown-editor.js"></script>
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/vendor/css/highlighting-{{.Theme}}.css">
    <title>{{template "page:title" . }}</title>
  </head>
  <body>

    {{ if .IsAuthenticated }}

	{{ if .IsAdmin }}
    
    		{{ template "partial:navbar:admin" . }}

	{{ else }}
    
	    {{ template "partial:navbar:authenticated" . }}
    
	{{ end }}
    
    {{ else }}
    
    	{{ template "partial:navbar:unauthenticated" . }}
    
    {{ end }}


  {{ template "page:content" . }}
    {{ if .IsAuthenticated}}
      {{ if not .IsAdmin}}
        {{ template "partial:search:dialog" }}
    {{ end }}
  {{ end }}

  </body>
</html>

{{end}}